{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:ap-northeast-1:094025684215:client/*"
    },
    {
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": [
        "arn:aws:iot:ap-northeast-1:094025684215:topic/$aws/certificates/create-from-csr/*",
        "arn:aws:iot:ap-northeast-1:094025684215:topic/$aws/provisioning-templates/rx72n_fleet_provisioning_template/provision/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:ap-northeast-1:094025684215:topicfilter/$aws/certificates/create-from-csr/*",
        "arn:aws:iot:ap-northeast-1:094025684215:topicfilter/$aws/provisioning-templates/rx72n_fleet_provisioning_template/provision/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": [
        "arn:aws:iot:ap-northeast-1:094025684215:topic/$aws/certificates/create-from-csr/*",
        "arn:aws:iot:ap-northeast-1:094025684215:topic/$aws/provisioning-templates/rx72n_fleet_provisioning_template/provision/*"
      ]
    }
  ]
}
