### Ported from Amazon FreeRTOS: https://github.com/aws/amazon-freertos/blob/master/.gitignore

# Ignore uncrustify backups
*.unc*

# Ignore documentation outputs
doc/html/*
doc/output/*
doc/tag/*
**/doc*/
!docs/
doxygen_warnings.txt

# Ignore IDE-specific files
/.metadata/
.vscode/*
*.o
*.d 
*.elf
*.hex
*.bin
*.rsu

# Ignore Python-related files
*.pyc

# Ignore Renesas e2 studio/CS+ specific ignore files/folders
HardwareDebug/
DefaultBuild/
trash/
*.mtud
*.rcpc

!/vendors/cypress/MTB/psoc6/psoc64tfm/COMPONENT_TFM_S_FW/tfm_s_unsigned.hex

# Ignore common temporary files
*.log
*.tmp
*.bak
RemoteSystemsTempFiles/*

# Ignore top-level build dir
/build*/

# Ignore certificate files (security-sensitive)
*.pem
*.crt

### Ignore IAR Embedded Workbench specific ignore files/folders
Debug/
settings/
Projects/aws_wifi_rx671_ek/e2studio_ccrx/src/whd_join_config_local.h
Projects/aws_wifi_rx671_ek/e2studio_ccrx/src/frtos_config/aws_iot_config_local.h
