            <component description="依存モジュール: r_bsp バージョン 7.70&#10;This module allocates a queue control block in an Open() call to handle indexing for buffers provided by the user application. Additional functions are provided to put and get data from the buffer queue, inspect the number of bytes available or in use, and to flush the queue. There is no limit to the number of queues supported, and queue control blocks can be allocated statically at build time or dynamically at run time." detailDescription="Byte-based circular buffer library." display="r_byteq" id="r_byteq2.20" version="2.20">
                <gridItem id="BYTEQ_CFG_PARAM_CHECKING_ENABLE" selectedIndex="0"/>
                <gridItem id="BYTEQ_CFG_USE_HEAP_FOR_CTRL_BLKS" selectedIndex="0"/>
                <gridItem id="BYTEQ_CFG_MAX_CTRL_BLKS" selectedIndex="32"/>
                <gridItem id="BYTEQ_CFG_PROTECT_QUEUE" selectedIndex="0"/>
                <gridItem id="BYTEQ_CFG_CRITICAL_SECTION" selectedIndex="0"/>
            </component>
            <source description="Components supporting Firmware Integration Technology" display="Firmware Integration Technology" id="com.renesas.smc.tools.swcomponent.fit.source"/>
            <source description="Components supporting Firmware Integration Technology" display="Firmware Integration Technology" id="com.renesas.smc.tools.swcomponent.fit.source"/>
        </configuration>
        <configuration inuse="true" name="r_sdio_rx">
            <component description="依存モジュール: r_bsp バージョン 7.70&#10;依存モジュール: r_sdhi_rx バージョン 2.20&#10;This module provides reusable SDIO protocol helpers above an RX SDHI host driver. The lower host issues CMD52 and CMD53 transactions through callbacks. The module includes CCCR/FBR helpers, CIS pointer reads, function enable polling, interrupt register helpers, CMD53 byte/block wrappers, and Broadcom/Infineon backplane-window helpers. CMD53 byte-mode function-1 read/write paths have been proven on EK-RX671 with Murata Type 1YN." detailDescription="SAFFTI original SDIO protocol helpers for RX MCUs." display="r_sdio_rx" id="r_sdio_rx1.00.saffti-original" version="1.00.saffti-original">
                <gridItem id="SDIO_CFG_PARAM_CHECKING_ENABLE" selectedIndex="0"/>
