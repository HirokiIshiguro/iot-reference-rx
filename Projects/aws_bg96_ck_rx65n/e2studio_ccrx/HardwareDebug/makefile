-include ../makefile.defs

# Add inputs and outputs from these tool invocations to the build variables
LINKER_OUTPUT_OUTPUTS += \
aws_bg96_ck_rx65n.abs

LIBRARY_GENERATOR_OUTPUTTYPE_OUTPUTS += \
aws_bg96_ck_rx65n.lib

CONVERTOR_OUTPUT_OUTPUTS += \
aws_bg96_ck_rx65n.mot

OBJS := \
$(COMPILER_OBJS) \
$(INDIVIDUAL_COMPILER_OBJS) \
$(ASSEMBLER_OBJS) \
$(CUSTOM_OBJS)

# All Target
all: $(CONVERTOR_OUTPUT_OUTPUTS)
	@echo 'Build complete.'

%.mot: $(LINKER_OUTPUT_OUTPUTS) Converter.sub
	@echo 'Invoking Converter: $@'
	rlink -subcommand="Converteraws_bg96_ck_rx65n.tmp"


aws_bg96_ck_rx65n.abs: $(LIBRARY_GENERATOR_OUTPUTTYPE_OUTPUTS) $(OBJS) $(ALL_ASMS)
	@echo 'Invoking Linker: $@'
	rlink -subcommand="Linkeraws_bg96_ck_rx65n.tmp"


aws_bg96_ck_rx65n.lib:
	@echo 'Invoking Library Generator: $@'
	lbgrx -subcommand="LibraryGeneratoraws_bg96_ck_rx65n.tmp"

aws_bg96_ck_rx65n.x: aws_bg96_ck_rx65n.abs
	renesas_cc_converter aws_bg96_ck_rx65n.abs aws_bg96_ck_rx65n.x

aws_bg96_ck_rx65n.udm: $(LINKER_OUTPUT_OUTPUTS) $(CONVERTOR_OUTPUT_OUTPUTS)
	udcollector -subcommand=udSubcommand.tmp -output=aws_bg96_ck_rx65n.udm

# Other Targets
clean:
	-$(file > clean_file.tmp, $(LINKER_OUTPUT_OUTPUTS) $(LIBRARY_GENERATOR_OUTPUTTYPE_OUTPUTS) $(CONVERTOR_OUTPUT_OUTPUTS) $(OBJS) $(ALL_COMMON_DEPS) $(DSP_DEPS) $(DSP_UPPER_DEPS) $(OUTPUT_FILES))
	-@ xargs -P 2 -s 26000 -t -a clean_file.tmp $(RM)
	-@$(RM) clean_file.tmp
	@echo ''
	@echo 'Clean complete.'

.PHONY: all clean  $(LINKER_OUTPUT_OUTPUTS)  $(LIBRARY_GENERATOR_OUTPUTTYPE_OUTPUTS)
-include ../makefile.targets

.SILENT:
